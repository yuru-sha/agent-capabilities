#!/usr/bin/env python3

from __future__ import annotations

import argparse
import re
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path


REPO_ROOT = Path(__file__).resolve().parents[1]
PROFILE_ROOT = REPO_ROOT / "profiles"
SOURCE_ROOT = REPO_ROOT
AGENT_ROOT = REPO_ROOT / "packs" / "software-engineering" / "agents"
DEFAULT_REPOSITORY = "yuru-sha/agent-capabilities"
NAME_PATTERN = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._+-]*$")


@dataclass(frozen=True, order=True)
class ExternalSkill:
    source: str
    skills: str | None = None


@dataclass(frozen=True)
class InstallPlan:
    profile_ids: tuple[str, ...]
    skills: tuple[tuple[str, Path], ...]
    agents: tuple[tuple[str, Path], ...]
    external_skills: tuple[ExternalSkill, ...]


def scalar(value: str) -> str:
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
        return value[1:-1]
    return value


def profile_id(profile_name: str) -> str:
    return profile_name.removesuffix(".yaml")


def load_profile(profile_name: str) -> dict:
    profile_name = profile_id(profile_name)
    path = PROFILE_ROOT / f"{profile_name}.yaml"
    if not path.is_file():
        raise ValueError(f"unknown profile: {profile_name}")

    values = {"skills": [], "agents": [], "external_skills": []}
    declared_id = None
    section = None
    subsection = None
    current_external: ExternalSkill | None = None
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        if not raw_line.strip() or raw_line.lstrip().startswith("#"):
            continue
        indent = len(raw_line) - len(raw_line.lstrip(" "))
        line = raw_line.strip()
        if indent == 0:
            subsection = None
            current_external = None
            if line.endswith(":"):
                section = line[:-1]
            elif line.startswith("id:"):
                declared_id = scalar(line.split(":", 1)[1])
            continue
        if section == "external_skills":
            if indent == 2 and line.startswith("- "):
                item = line[2:]
                if item.startswith("source:"):
                    source = scalar(item.split(":", 1)[1])
                    if not source:
                        raise ValueError(f"external Skill source is empty in {path}")
                    current_external = ExternalSkill(source=source)
                    values["external_skills"].append(current_external)
                else:
                    source = scalar(item)
                    if source:
                        values["external_skills"].append(ExternalSkill(source=source))
                    current_external = None
                continue
            if indent == 4 and line.startswith("skills:") and current_external is not None:
                skills = scalar(line.split(":", 1)[1])
                if not skills:
                    raise ValueError(f"external Skill selector is empty in {path}")
                current_external = ExternalSkill(source=current_external.source, skills=skills)
                values["external_skills"][-1] = current_external
                continue
        if indent == 2 and line.endswith(":"):
            subsection = line[:-1]
            continue
        if not line.startswith("- "):
            continue
        value = scalar(line[2:])
        if section == "skills" and subsection == "include":
            values["skills"].append(value)
        elif section == "agents" and subsection == "include":
            values["agents"].append(value)
    if declared_id != profile_name:
        raise ValueError(f"profile id mismatch in {path}: {declared_id!r}")
    return values


def skill_name(skill_dir: Path) -> str:
    frontmatter = skill_dir / "SKILL.md"
    lines = frontmatter.read_text(encoding="utf-8").splitlines()
    if not lines or lines[0].strip() != "---":
        raise ValueError(f"missing frontmatter: {frontmatter}")
    for line in lines[1:]:
        if line.strip() == "---":
            break
        if line.startswith("name:"):
            name = scalar(line.split(":", 1)[1])
            if NAME_PATTERN.fullmatch(name) is None:
                raise ValueError(f"invalid Skill name {name!r}: {frontmatter}")
            if skill_dir.name != name:
                raise ValueError(
                    f"Skill directory name {skill_dir.name!r} does not match "
                    f"frontmatter name {name!r}: {frontmatter}"
                )
            return name
    raise ValueError(f"missing Skill name: {frontmatter}")


def resolve_skills(patterns: list[str]) -> dict[str, Path]:
    resolved: dict[str, Path] = {}
    for pattern in patterns:
        matches = sorted(
            path
            for path in SOURCE_ROOT.glob(pattern)
            if path.is_dir() and (path / "SKILL.md").is_file()
        )
        if not matches:
            raise ValueError(f"Skill selector matched nothing: {pattern}")
        for path in matches:
            name = skill_name(path)
            source = path.resolve()
            previous = resolved.get(name)
            if previous is not None and previous != source:
                raise ValueError(f"duplicate Skill name {name!r}: {previous} and {source}")
            resolved[name] = source
    return dict(sorted(resolved.items()))


def resolve_agents(agent_ids: list[str]) -> dict[str, Path]:
    resolved = {}
    for agent_id in sorted(set(agent_ids)):
        if NAME_PATTERN.fullmatch(agent_id) is None:
            raise ValueError(f"invalid Agent id: {agent_id!r}")
        path = AGENT_ROOT / f"{agent_id}.md"
        if not path.is_file():
            raise ValueError(f"Agent not found: {path}")
        resolved[agent_id] = path.resolve()
    return resolved


def resolve_profile(profile_name: str) -> dict:
    normalized_id = profile_id(profile_name)
    values = load_profile(normalized_id)
    return {
        "id": normalized_id,
        "skills": resolve_skills(values["skills"]),
        "agents": resolve_agents(values["agents"]),
        "external_skills": values["external_skills"],
    }


def resolve_profiles(profile_names: list[str]) -> list[dict]:
    resolved = {}
    for name in profile_names:
        profile = resolve_profile(name)
        resolved[profile["id"]] = profile
    return [resolved[name] for name in sorted(resolved)]


def build_install_plan(profile_names: list[str]) -> InstallPlan:
    profiles = resolve_profiles(profile_names)
    skills: dict[str, Path] = {}
    agents: dict[str, Path] = {}
    external_skills: set[ExternalSkill] = set()
    for profile in profiles:
        for name, source in profile["skills"].items():
            previous = skills.get(name)
            if previous is not None and previous != source:
                raise ValueError(f"conflicting Skill {name!r}: {previous} and {source}")
            skills[name] = source
        for agent_id, source in profile["agents"].items():
            previous = agents.get(agent_id)
            if previous is not None and previous != source:
                raise ValueError(f"conflicting Agent {agent_id!r}: {previous} and {source}")
            agents[agent_id] = source
        external_skills.update(profile["external_skills"])
    return InstallPlan(
        profile_ids=tuple(profile["id"] for profile in profiles),
        skills=tuple(sorted(skills.items())),
        agents=tuple(sorted(agents.items())),
        external_skills=tuple(sorted(external_skills)),
    )


def agent_destinations(plan: InstallPlan, scope: str, target: Path | None) -> tuple[tuple[Path, Path], ...]:
    root = target / ".omp" / "agents" if scope == "project" else Path.home() / ".omp" / "agent" / "agents"
    return tuple((root / f"{agent_id}.md", source) for agent_id, source in plan.agents)


def preflight_agents(destinations: tuple[tuple[Path, Path], ...]) -> None:
    for destination, source in destinations:
        if not destination.exists() and not destination.is_symlink():
            continue
        if destination.is_file() and destination.read_bytes() == source.read_bytes():
            continue
        raise ValueError(f"Agent destination conflict: {destination}")


def gh_argv(repository: str, skill_name: str, skill_path: Path, *, from_local: bool, agent: str, scope: str) -> list[str]:
    gh_agent = "universal" if agent == "omp" else agent
    if from_local:
        return ["gh", "skill", "install", str(skill_path.resolve()), skill_name, "--from-local", "--agent", gh_agent, "--scope", scope]
    relative_skill = skill_path.relative_to(SOURCE_ROOT).as_posix() + "/SKILL.md"
    return ["gh", "skill", "install", repository, relative_skill, "--agent", gh_agent, "--scope", scope]




def external_skill_argv(external: ExternalSkill) -> list[str] | None:
    if external.skills is None:
        return None
    if external.skills != "all":
        raise ValueError(f"unsupported external Skill selector {external.skills!r} for {external.source}")
    return ["npx", "skills", "add", external.source, "--all"]


def install_profiles(plan: InstallPlan, *, agent: str, scope: str, target: Path | None, from_local: bool) -> int:
    destinations = agent_destinations(plan, scope, target)
    preflight_agents(destinations)
    cwd = target if scope == "project" else None
    for skill_name, skill_path in plan.skills:
        result = subprocess.run(
            gh_argv(DEFAULT_REPOSITORY, skill_name, skill_path, from_local=from_local, agent=agent, scope=scope),
            cwd=cwd,
            check=False,
        )
        if result.returncode:
            print(f"gh skill install failed with status {result.returncode}", file=sys.stderr)
            return result.returncode
    for external in plan.external_skills:
        argv = external_skill_argv(external)
        if argv is None:
            print(f"External Skill required (not installed): {external.source}")
            continue
        if scope != "project":
            print(
                f"External Skill required for user scope (not installed automatically): {external.source}",
                file=sys.stderr,
            )
            continue
        result = subprocess.run(argv, cwd=cwd, check=False)
        if result.returncode:
            print(
                f"external Skill install failed for {external.source} with status {result.returncode}",
                file=sys.stderr,
            )
            return result.returncode
    for destination, source in destinations:
        if destination.is_file() and destination.read_bytes() == source.read_bytes():
            continue
        destination.parent.mkdir(parents=True, exist_ok=True)
        destination.write_bytes(source.read_bytes())
    print(f"Profiles: {', '.join(plan.profile_ids)}")
    return 0


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Install selected agent-capabilities Profiles.")
    parser.add_argument("profiles", nargs="+", help="profile IDs, for example: rust sqlite")
    parser.add_argument("--agent", required=True, metavar="HOST", help="host passed to gh skill install --agent; omp is mapped to universal; selects Skills, not the OMP Agent-definition directory")
    parser.add_argument("--scope", required=True, choices=("project", "user"), help="gh installation scope and OMP Agent-definition target (.omp/agents for project; ~/.omp/agent/agents for user)")
    parser.add_argument("--target", help="project directory (default: current directory); OMP Agent definitions go under .omp/agents")
    parser.add_argument("--from-local", action="store_true", help="install Skills from this checkout instead of the published repository")
    args = parser.parse_args(argv)
    if args.scope == "user" and args.target is not None:
        parser.error("--target cannot be used with --scope user")
    return args


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    target = None
    if args.scope == "project":
        target = Path(args.target or ".").expanduser().resolve()
        if not target.is_dir():
            print(f"target directory does not exist: {target}", file=sys.stderr)
            return 2
    try:
        plan = build_install_plan(args.profiles)
        return install_profiles(plan, agent=args.agent, scope=args.scope, target=target, from_local=args.from_local)
    except (OSError, ValueError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
